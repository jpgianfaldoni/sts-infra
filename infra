#!/usr/bin/env bash
# ./infra launcher. The CLI is the Python package in lib/sts_infra (standard
# library only); run without arguments for usage.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
command -v python3 >/dev/null 2>&1 || { echo "ERROR: python3 (3.9 or newer) is required" >&2; exit 12; }
exec python3 -I "$ROOT/lib/sts_infra/__main__.py" "$@"
