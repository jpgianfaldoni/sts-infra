#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

EXIT_LOGIN_REQUIRED=10
EXIT_IDENTITY_MISMATCH=11
EXIT_MISSING_TOOL=12
EXIT_VERIFY_FAILED=13

AWS_DATABRICKS_ACCOUNTS_HOST="https://accounts.cloud.databricks.com"
AZURE_DATABRICKS_ACCOUNTS_HOST="https://accounts.azuredatabricks.net"
# Ambient credentials that would compete with an explicitly selected profile.
AWS_STATIC_CREDENTIAL_VARS=(AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SECURITY_TOKEN)
DATABRICKS_CREDENTIAL_VARS=(DATABRICKS_CONFIG_PROFILE DATABRICKS_HOST DATABRICKS_ACCOUNT_ID DATABRICKS_WORKSPACE_ID DATABRICKS_TOKEN DATABRICKS_CLIENT_ID DATABRICKS_CLIENT_SECRET DATABRICKS_AUTH_TYPE DATABRICKS_USERNAME DATABRICKS_PASSWORD DATABRICKS_AZURE_RESOURCE_ID)
# Any of these means Azure automation supplies its own Databricks credentials.
AZURE_DATABRICKS_AUTOMATION_VARS=(DATABRICKS_TOKEN DATABRICKS_CLIENT_ID DATABRICKS_AUTH_TYPE ARM_CLIENT_ID ARM_USE_MSI ARM_USE_OIDC)
AUTH_DEPLOYMENT_FIELDS='["aws_account_id","aws_profile","azure_subscription_id","azure_tenant_id","databricks_account_id","databricks_account_profile","databricks_workspace_profile"]'
TARGET_AWS_FIELDS='["cloud","description","aws_account_id","databricks_account_id","region","aws_profile","databricks_account_profile","aws_sso","metastore","classic_node_type"]'
TARGET_AZURE_FIELDS='["cloud","description","subscription_id","tenant_id","databricks_account_id","location","databricks_account_profile","classic_node_type"]'

if command -v shasum >/dev/null 2>&1; then
  SHA256_COMMAND=(shasum -a 256)
else
  SHA256_COMMAND=(sha256sum)
fi

AWS_ENV_UNSET=()
DB_ENV_UNSET=()
AUTH_TF_ARGS=()
CHECK_RESULTS=()
CHECK_STATUSES=()
AUTH_WARNINGS=()

usage() {
  cat <<'EOF'
Usage:
  ./infra list
  ./infra templates [<aws|azure>] [--json]
  ./infra new <aws|azure> <name> --template <template> [--target <target>]
  ./infra explain <aws|azure> <environment.tfvars> [--json]
  ./infra ls [--json]
  ./infra status <aws|azure> <environment.tfvars> [--json]
  ./infra targets [--json]
  ./infra targets add <name> --cloud <aws|azure> [target options]
  ./infra targets remove <name>
  ./infra setup <aws|azure> <environment.tfvars> [setup options]
  ./infra doctor <aws|azure> [<environment.tfvars>] [--json] [--wait <seconds>]
  ./infra validate <aws|azure>
  ./infra plan <aws|azure> <environment.tfvars>
  ./infra apply <aws|azure> <environment.tfvars>
  ./infra verify <aws|azure> <environment.tfvars> [--json] [--endpoint-wait <seconds>]
  ./infra seed-access-plan azure <environment.tfvars> [--operator-ip <ipv4>]
  ./infra seed-access-apply azure <environment.tfvars>
  ./infra seed azure <environment.tfvars> [--source <directory>] [--destination-path <path>]
  ./infra output <aws|azure> <environment.tfvars> [--json]
  ./infra destroy-plan <aws|azure> <environment.tfvars>
  ./infra destroy <aws|azure> <environment.tfvars> --confirm destroy-<cloud>
  ./infra state-migrate <aws|azure> <environment.tfvars> --confirm migrate-<cloud>-<deployment-id>
  ./infra endpoints aws status <environment.tfvars>
  ./infra endpoints aws accept <environment.tfvars> --service-id vpce-svc-... --endpoint-id vpce-...
  ./infra endpoints aws reject <environment.tfvars> --service-id vpce-svc-... --endpoint-id vpce-... --confirm reject-aws-endpoint
  ./infra endpoints azure status <environment.tfvars>
  ./infra endpoints azure approve <environment.tfvars> --connection-id <id>
  ./infra endpoints azure reject <environment.tfvars> --connection-id <id> --confirm reject-azure-endpoint

Setup options (setup asks no questions with --yes or when stdin is not a terminal):
  --yes                        accept the detected defaults without prompting
  --aws-profile <name>         AWS CLI profile to use or create
  --aws-account-id <id>        account for a new SSO profile (default: aws_account_id in tfvars)
  --sso-start-url <url>        IAM Identity Center start URL for a new SSO profile
  --sso-region <region>        IAM Identity Center region for a new SSO profile
  --sso-role-name <role>       permission-set role for a new SSO profile
  --sso-session <name>         shared SSO session for new profiles (default: sts-infra)
  --databricks-profile <name>  Databricks account profile to use or create
  --no-databricks-profile      Azure only: use the Azure CLI identity for account APIs
  --workspace-profile <name>   Databricks workspace profile to use or create
  --skip-workspace             do not set up workspace authentication
  --workspace-login            log in to the workspace even when no check requires it yet
  --tenant <id>                Azure only: Entra tenant for az login
  --device-code                use device-code login for AWS and Azure
  --force-login                log in again even when the AWS or Azure session is valid

Target options (non-secret identifiers; saved in the local targets file):
  --description <text>
  AWS:   --aws-account-id <id> --databricks-account-id <uuid> [--region <region>]
         [--sso-start-url <url> --sso-region <region> --sso-role-name <role>]
         [--aws-profile <name>] [--databricks-profile <name>]
         [--metastore <name>]   Unity Catalog metastore new environments use instead of auto
  Azure: --subscription-id <uuid> [--tenant-id <uuid>] [--databricks-account-id <uuid>]
         [--location <location>] [--databricks-profile <name>]
  Both:  [--classic-node-type <type>]   node type for the lab check cluster in new environments

Authentication overrides for local operators:
  AWS_PROFILE
  DATABRICKS_ACCOUNT_PROFILE
  DATABRICKS_WORKSPACE_PROFILE
  STS_INFRA_AUTH_CONFIG (defaults to ~/.config/sts-infra/auth.json)
  STS_INFRA_TARGETS (defaults to targets.json next to the auth config)
  STS_INFRA_ALLOW_UNPINNED_ACCOUNT=1 (automation only: allow AWS environments without a pinned account)

Automation can omit profiles and use the standard AWS, Azure, and Databricks
provider environment variables. Set INFRA_DEPLOYMENT_ID to supply a stable
application deployment ID; otherwise the tfvars filename is used.

Exit codes: 0 success, 1 error, 2 usage, 10 browser login required,
11 identity or account mismatch (or no pinned account), 12 missing or outdated
tool, 13 a lab check failed (verify).
EOF
}

die() { echo "ERROR: $*" >&2; exit 1; }
die_code() {
  local code="$1"
  shift
  echo "ERROR: $*" >&2
  exit "$code"
}

cloud_root() {
  case "$1" in
    aws|azure) printf '%s/deployments/%s' "$ROOT" "$1" ;;
    *) die "cloud must be aws or azure" ;;
  esac
}

absolute_file() {
  local file="$1"
  [[ -f "$file" ]] || die "tfvars file not found: $file"
  printf '%s/%s' "$(cd "$(dirname "$file")" && pwd)" "$(basename "$file")"
}

# Prints a simple assignment from a tfvars file: a top-level `key = value`, or
# `parent = { key = value }` when a parent block is given. Comments are ignored
# and `null` is treated as unset.
tfvar_value() {
  local file="$1" key="$2" parent="${3:-}"
  awk -v key="$key" -v parent="$parent" '
    function scan(line,    i, c, n, out, quoted) {
      out = ""; quoted = 0; delta = 0; n = length(line)
      for (i = 1; i <= n; i++) {
        c = substr(line, i, 1)
        if (quoted) {
          out = out c
          if (c == "\\") { i++; out = out substr(line, i, 1) }
          else if (c == "\"") quoted = 0
          continue
        }
        if (c == "#" || (c == "/" && substr(line, i + 1, 1) == "/")) break
        if (c == "\"") quoted = 1
        else if (c == "{" || c == "[") delta++
        else if (c == "}" || c == "]") delta--
        out = out c
      }
      return out
    }
    function emit(text,    value) {
      value = text
      sub(/^[[:space:]]+/, "", value)
      if (substr(value, 1, 1) == "\"") {
        value = substr(value, 2)
        sub(/".*$/, "", value)
      } else {
        sub(/[[:space:],}].*$/, "", value)
        if (value == "null") value = ""
      }
      if (value != "") print value
      exit
    }
    {
      line = scan($0)
      if (parent == "") {
        if (depth == 0 && match(line, "^[[:space:]]*" key "[[:space:]]*=")) emit(substr(line, RSTART + RLENGTH))
      } else if (depth == 0 && match(line, "^[[:space:]]*" parent "[[:space:]]*=[[:space:]]*[{]")) {
        inside = 1
        rest = substr(line, RSTART + RLENGTH)
        if (match(rest, "(^|[,[:space:]])" key "[[:space:]]*=")) emit(substr(rest, RSTART + RLENGTH))
      } else if (inside && depth == 1 && match(line, "^[[:space:]]*" key "[[:space:]]*=")) {
        emit(substr(line, RSTART + RLENGTH))
      }
      depth += delta
      if (depth <= 0) { depth = 0; inside = 0 }
    }
  ' "$file"
}

file_sha256() {
  "${SHA256_COMMAND[@]}" "$1" | awk '{print $1}'
}

sha1_hex() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 1 | awk '{print $1}'
  else
    sha1sum | awk '{print $1}'
  fi
}

stdin_sha256() {
  "${SHA256_COMMAND[@]}" | awk '{print $1}'
}

normalize_host() {
  local host="${1%/}"
  if [[ -n "$host" && "$host" != http://* && "$host" != https://* ]]; then
    host="https://$host"
  fi
  printf '%s' "$host" | tr '[:upper:]' '[:lower:]'
}

version_at_least() {
  local IFS=. i
  local -a have need
  read -r -a have <<< "${1%%[-+]*}"
  read -r -a need <<< "$2"
  for i in 0 1 2; do
    if ((10#${have[i]:-0} > 10#${need[i]:-0})); then return 0; fi
    if ((10#${have[i]:-0} < 10#${need[i]:-0})); then return 1; fi
  done
  return 0
}

configuration_sha256() {
  local cloud="$1" file hash
  (
    cd "$ROOT"
    local sources=("deployments/$cloud" "modules/$cloud")
    [[ ! -d modules/shared ]] || sources+=(modules/shared)
    {
      for file in infra components.json; do
        hash="$(file_sha256 "$file")"
        printf '%s  %s\n' "$hash" "$file"
      done
      while IFS= read -r file; do
        hash="$(file_sha256 "$file")"
        printf '%s  %s\n' "$hash" "$file"
      done < <(
        find "${sources[@]}" -type f \
          -not -path '*/.terraform/*' -not -path '*/tests/*' -not -name '*.tfstate*' -not -name '.DS_Store' | LC_ALL=C sort
      )
    } | stdin_sha256
  )
}

deployment_id_for() {
  local vars="$1" id
  id="${INFRA_DEPLOYMENT_ID:-$(basename "$vars" .tfvars)}"
  [[ "$id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || die "deployment ID must match [A-Za-z0-9][A-Za-z0-9._-]{0,127}"
  [[ "$id" != "default" ]] || die "deployment ID 'default' is reserved by Terraform"
  printf '%s' "$id"
}

# ---------------------------------------------------------------------------
# Local authentication mapping (profile names and account identifiers only)
# ---------------------------------------------------------------------------

auth_config_path() {
  if [[ -n "${STS_INFRA_AUTH_CONFIG:-}" ]]; then
    printf '%s' "$STS_INFRA_AUTH_CONFIG"
  elif [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
    printf '%s/sts-infra/auth.json' "$XDG_CONFIG_HOME"
  else
    printf '%s/.config/sts-infra/auth.json' "${HOME:?HOME is required to locate the local authentication config}"
  fi
}

validate_auth_config() {
  local config="$1"
  [[ -f "$config" ]] || return 0
  jq -e --argjson fields "$AUTH_DEPLOYMENT_FIELDS" '
    def nonempty_strings: all(.[]; type == "string" and length > 0);
    type == "object" and
    .version == 1 and
    ((keys - ["accounts", "aws_sso", "deployments", "version"]) | length == 0) and
    (.deployments | type == "object") and
    all(.deployments[]; type == "object" and ((keys - $fields) | length == 0) and nonempty_strings) and
    ((.accounts // {}) | type == "object") and
    all((.accounts // {})[]; type == "object" and ((keys - ["aws_profile", "databricks_account_profile"]) | length == 0) and nonempty_strings) and
    ((.aws_sso // {}) | type == "object" and ((keys - ["region", "role_name", "session", "start_url"]) | length == 0) and nonempty_strings)
  ' "$config" >/dev/null || die "invalid local authentication config: $config"
}

auth_config_query() {
  local filter="$1" config
  shift
  config="$(auth_config_path)"
  [[ -f "$config" ]] || return 0
  validate_auth_config "$config"
  jq -r "$@" "($filter) // empty" "$config"
}

deployment_config_value() {
  auth_config_query '.deployments[$key][$field]' --arg key "$ENV_CLOUD/$ENV_ID" --arg field "$1"
}

account_config_value() {
  auth_config_query '(.accounts // {})[$key][$field]' --arg key "$1" --arg field "$2"
}

aws_sso_config_value() {
  auth_config_query '(.aws_sso // {})[$field]' --arg field "$1"
}

auth_config_write() {
  local filter="$1" config config_dir temp
  shift
  config="$(auth_config_path)"
  config_dir="$(dirname "$config")"
  validate_auth_config "$config"
  (
    umask 077
    mkdir -p "$config_dir"
    temp="$(mktemp "$config_dir/.auth.json.tmp.XXXXXX")"
    trap 'rm -f "$temp"' EXIT
    if [[ -f "$config" ]]; then
      jq "$@" "$filter" "$config" > "$temp"
    else
      jq -n "$@" "{version: 1, deployments: {}} | $filter" > "$temp"
    fi
    chmod 600 "$temp"
    mv "$temp" "$config"
    trap - EXIT
  )
  validate_auth_config "$config"
}

# Replaces this deployment's mapping. Arguments are field=value pairs; empty
# values are omitted.
save_deployment_mapping() {
  local entry='{}' pair
  for pair in "$@"; do
    entry="$(jq -c --arg k "${pair%%=*}" --arg v "${pair#*=}" 'if $v == "" then . else . + {($k): $v} end' <<< "$entry")"
  done
  auth_config_write '.deployments[$key] = $entry' --arg key "$ENV_CLOUD/$ENV_ID" --argjson entry "$entry"
}

# Remembers a profile for an account so other environments in the same account
# resolve it without running setup again.
save_account_mapping() {
  local key="$1" field="$2" value="$3"
  [[ -n "$value" ]] || return 0
  auth_config_write '.accounts = ((.accounts // {}) | .[$key] = ((.[$key] // {}) + {($field): $value}))' \
    --arg key "$key" --arg field "$field" --arg value "$value"
}

save_aws_sso_defaults() {
  local session="$1" start_url="$2" region="$3" role="$4"
  auth_config_write '.aws_sso = ({session: $session, start_url: $start_url, region: $region} + (if $role == "" then {} else {role_name: $role} end))' \
    --arg session "$session" --arg start_url "$start_url" --arg region "$region" --arg role "$role"
}

# ---------------------------------------------------------------------------
# Named account targets (non-secret identifiers shared by many environments)
# ---------------------------------------------------------------------------

targets_path() {
  if [[ -n "${STS_INFRA_TARGETS:-}" ]]; then
    printf '%s' "$STS_INFRA_TARGETS"
  else
    printf '%s/targets.json' "$(dirname "$(auth_config_path)")"
  fi
}

validate_targets() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  jq -e --argjson aws "$TARGET_AWS_FIELDS" --argjson azure "$TARGET_AZURE_FIELDS" '
    def nonempty_strings: all(.[]; type == "string" and length > 0);
    type == "object" and
    .version == 1 and
    ((keys - ["targets", "version"]) | length == 0) and
    (.targets | type == "object") and
    all(.targets | to_entries[];
      (.key | test("^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")) and
      (.value | type == "object") and
      (.value.cloud == "aws" or .value.cloud == "azure") and
      (.value | (keys - (if .cloud == "aws" then $aws else $azure end)) | length == 0) and
      (.value | del(.aws_sso) | nonempty_strings) and
      ((.value.aws_sso // {}) | type == "object" and ((keys - ["start_url", "region", "role_name"]) | length == 0) and nonempty_strings))
  ' "$file" >/dev/null || die "invalid targets file: $file"
}

# Prints a field (dotted path) of the environment's target, or nothing.
target_value() {
  local field="$1" file
  [[ -n "${ENV_TARGET:-}" ]] || return 0
  file="$(targets_path)"
  [[ -f "$file" ]] || return 0
  validate_targets "$file"
  jq -r --arg name "$ENV_TARGET" --arg field "$field" \
    '(.targets[$name] // {}) | getpath($field | split(".")) // empty' "$file"
}

target_defined() {
  local file
  file="$(targets_path)"
  [[ -f "$file" ]] || return 1
  validate_targets "$file"
  jq -e --arg name "$1" '.targets | has($name)' "$file" >/dev/null
}

# Prints a tfvars value, falling back to the target field of the same meaning.
setting_value() {
  local key="$1" field="${2:-$1}" value
  value="$(tfvar_value "$ENV_VARS" "$key")"
  [[ -n "$value" ]] || value="$(target_value "$field")"
  printf '%s' "$value"
}

targets_write() {
  local filter="$1" file file_dir temp
  shift
  file="$(targets_path)"
  file_dir="$(dirname "$file")"
  validate_targets "$file"
  (
    umask 077
    mkdir -p "$file_dir"
    temp="$(mktemp "$file_dir/.targets.json.tmp.XXXXXX")"
    trap 'rm -f "$temp"' EXIT
    if [[ -f "$file" ]]; then
      jq "$@" "$filter" "$file" > "$temp"
    else
      jq -n "$@" "{version: 1, targets: {}} | $filter" > "$temp"
    fi
    chmod 600 "$temp"
    mv "$temp" "$file"
    trap - EXIT
  )
  validate_targets "$file"
}

targets_list() {
  local format="$1" file
  file="$(targets_path)"
  validate_targets "$file"
  if [[ "$format" == "json" ]]; then
    if [[ -f "$file" ]]; then
      jq --arg path "$file" '{version: 1, path: $path, targets: .targets}' "$file"
    else
      jq -n --arg path "$file" '{version: 1, path: $path, targets: {}}'
    fi
    return 0
  fi
  if [[ ! -f "$file" ]] || jq -e '.targets | length == 0' "$file" >/dev/null; then
    echo "No targets defined in $file."
    echo "Add one with: ./infra targets add <name> --cloud aws --aws-account-id <id> --databricks-account-id <uuid> [--region <region>]"
    echo "          or: ./infra targets add <name> --cloud azure --subscription-id <id> [--databricks-account-id <uuid>] [--location <location>]"
    return 0
  fi
  echo "Targets ($file):"
  jq -r '
    .targets | to_entries[] |
    .value as $t |
    [.key, $t.cloud,
     (if $t.cloud == "aws" then "aws " + ($t.aws_account_id // "?") else "subscription " + ($t.subscription_id // "?") end),
     ("databricks " + ($t.databricks_account_id // "-")),
     ($t.region // $t.location // "-"),
     ($t.description // "")] | @tsv
  ' "$file" | while IFS=$'\t' read -r name cloud account databricks region description; do
    printf '  %-22s %-6s %-34s %-49s %-14s %s\n' "$name" "$cloud" "$account" "$databricks" "$region" "$description"
  done
}

targets_add() {
  local name="${1:-}" cloud="" entry='{}' key value flag
  [[ -n "$name" && "$name" != -* ]] || die_code 2 "targets add requires a name: ./infra targets add <name> --cloud <aws|azure> ..."
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die_code 2 "target names must match [A-Za-z0-9][A-Za-z0-9._-]{0,63}"
  shift
  while [[ $# -gt 0 ]]; do
    flag="$1"
    [[ $# -ge 2 && -n "$2" ]] || die_code 2 "$flag requires a value"
    value="$2"
    case "$flag" in
      --cloud) cloud="$value"; key=cloud ;;
      --description) key=description ;;
      --aws-account-id) [[ "$value" =~ ^[0-9]{12}$ ]] || die_code 2 "--aws-account-id must be 12 digits"; key=aws_account_id ;;
      --databricks-account-id) [[ "$value" =~ ^[0-9a-fA-F-]{36}$ ]] || die_code 2 "--databricks-account-id must be a UUID"; key=databricks_account_id ;;
      --region) key=region ;;
      --aws-profile) key=aws_profile ;;
      --databricks-profile) key=databricks_account_profile ;;
      --sso-start-url) key=aws_sso.start_url ;;
      --sso-region) key=aws_sso.region ;;
      --sso-role-name) key=aws_sso.role_name ;;
      --subscription-id) [[ "$value" =~ ^[0-9a-fA-F-]{36}$ ]] || die_code 2 "--subscription-id must be a UUID"; key=subscription_id ;;
      --tenant-id) [[ "$value" =~ ^[0-9a-fA-F-]{36}$ ]] || die_code 2 "--tenant-id must be a UUID"; key=tenant_id ;;
      --location) key=location ;;
      --metastore) key=metastore ;;
      --classic-node-type) key=classic_node_type ;;
      *) die_code 2 "unknown targets add option: $flag" ;;
    esac
    entry="$(jq -c --arg path "$key" --arg value "$value" 'setpath($path | split("."); $value)' <<< "$entry")"
    shift 2
  done
  [[ "$cloud" == "aws" || "$cloud" == "azure" ]] || die_code 2 "targets add requires --cloud aws or --cloud azure"
  if [[ "$cloud" == "aws" ]]; then
    jq -e 'has("aws_account_id") and has("databricks_account_id")' <<< "$entry" >/dev/null ||
      die_code 2 "AWS targets need --aws-account-id and --databricks-account-id"
    jq -e '(.aws_sso // {}) | (length == 0 or length == 3)' <<< "$entry" >/dev/null ||
      die_code 2 "pass all of --sso-start-url, --sso-region, and --sso-role-name, or none of them"
  else
    jq -e 'has("subscription_id")' <<< "$entry" >/dev/null || die_code 2 "Azure targets need --subscription-id"
    jq -e 'has("metastore") | not' <<< "$entry" >/dev/null || die_code 2 "--metastore applies to AWS targets only"
  fi
  local verb="Added"
  if target_defined "$name"; then verb="Updated"; fi
  targets_write '.targets[$name] = $entry' --arg name "$name" --argjson entry "$entry"
  echo "$verb target '$name' in $(targets_path)."
  echo "Use it from an environment file with: target = \"$name\""
}

targets_command() {
  local subcommand="${1:-list}"
  case "$subcommand" in
    list) targets_list text ;;
    --json) targets_list json ;;
    add) shift; targets_add "$@" ;;
    remove)
      [[ $# -eq 2 ]] || die_code 2 "targets remove requires a name"
      target_defined "$2" || die "target '$2' is not defined in $(targets_path)"
      targets_write 'del(.targets[$name])' --arg name "$2"
      echo "Removed target '$2' from $(targets_path)."
      ;;
    *) usage; exit 2 ;;
  esac
}

# ---------------------------------------------------------------------------
# Environment, state, and locking
# ---------------------------------------------------------------------------

prepare_environment() {
  local cloud="$1" vars="$2"
  ENV_CLOUD="$cloud"
  ENV_VARS="$(absolute_file "$vars")"
  ENV_DIR="$(cloud_root "$cloud")"
  ENV_ID="$(deployment_id_for "$ENV_VARS")"
  ENV_TARGET="$(tfvar_value "$ENV_VARS" target)"
  ENV_STATE_DIR="$ROOT/.state/$cloud/$ENV_ID"
  ENV_STATE="$ENV_STATE_DIR/terraform.tfstate"
  ENV_BINDING="$ENV_STATE_DIR/environment.path"
  ENV_ARTIFACTS="$ROOT/.artifacts/$cloud/$ENV_ID"
  ENV_TF_DATA="$ENV_ARTIFACTS/.terraform"
  if [[ "$ENV_VARS" == "$ROOT"/* ]]; then
    DISPLAY_VARS="${ENV_VARS#"$ROOT"/}"
  else
    DISPLAY_VARS="$ENV_VARS"
  fi
}

bind_environment() {
  local existing workspace_link workspace_target
  mkdir -p "$ENV_STATE_DIR" "$ENV_ARTIFACTS" "$ENV_TF_DATA"
  workspace_link="$ENV_DIR/terraform.tfstate.d"
  workspace_target="$ROOT/.state/$ENV_CLOUD"
  if [[ -L "$workspace_link" ]]; then
    [[ "$(readlink "$workspace_link")" == "$workspace_target" ]] || die "$workspace_link points to an unexpected state directory"
  elif [[ -e "$workspace_link" ]]; then
    die "$workspace_link already exists and is not managed by ./infra"
  else
    ln -s "$workspace_target" "$workspace_link"
  fi
  if [[ -f "$ENV_BINDING" ]]; then
    existing="$(cat "$ENV_BINDING")"
    [[ "$existing" == "$ENV_VARS" ]] || die "deployment ID '$ENV_ID' is already bound to another environment file: $existing"
  else
    printf '%s\n' "$ENV_VARS" > "$ENV_BINDING"
  fi
}

check_legacy_state() {
  local legacy_state="$ENV_DIR/terraform.tfstate"
  local legacy_plan_path="$ROOT/.artifacts/$ENV_CLOUD/terraform.tfplan.tfvars.path"
  [[ -f "$legacy_state" && ! -f "$ENV_STATE" ]] || return 0

  if [[ ! -f "$legacy_plan_path" || "$(cat "$legacy_plan_path")" == "$ENV_VARS" ]]; then
    die "legacy state exists at $legacy_state. Migrate it explicitly with: ./infra state-migrate $ENV_CLOUD $ENV_VARS --confirm migrate-$ENV_CLOUD-$ENV_ID"
  fi
}

acquire_operation_lock() {
  local pid host command
  OPERATION_LOCK="$ENV_ARTIFACTS/.operation.lock"
  mkdir -p "$ENV_ARTIFACTS"
  if ! mkdir "$OPERATION_LOCK" 2>/dev/null; then
    pid="$(cat "$OPERATION_LOCK/pid" 2>/dev/null || true)"
    host="$(cat "$OPERATION_LOCK/host" 2>/dev/null || true)"
    command="$(cat "$OPERATION_LOCK/command" 2>/dev/null || true)"
    if [[ -n "$pid" && "$host" == "$(hostname)" ]] && ! kill -0 "$pid" 2>/dev/null; then
      echo "Removing a stale operation lock left by process $pid (${command:-unknown command})." >&2
      rm -f "$OPERATION_LOCK/pid" "$OPERATION_LOCK/host" "$OPERATION_LOCK/command"
      rmdir "$OPERATION_LOCK"
      mkdir "$OPERATION_LOCK" 2>/dev/null || die "another operation is already running for deployment '$ENV_ID'"
    elif [[ -n "$pid" ]]; then
      die "another operation is already running for deployment '$ENV_ID' (process $pid on ${host:-unknown host}: ${command:-unknown command})"
    else
      die "another operation is already running for deployment '$ENV_ID'. If no ./infra process is running, remove $OPERATION_LOCK"
    fi
  fi
  printf '%s\n' "$$" > "$OPERATION_LOCK/pid"
  hostname > "$OPERATION_LOCK/host"
  printf '%s\n' "${INFRA_COMMAND_LINE:-./infra}" > "$OPERATION_LOCK/command"
  trap 'release_operation_lock' EXIT
  trap 'on_interrupt 130' INT
  trap 'on_interrupt 143' TERM
}

release_operation_lock() {
  if [[ -n "${OPERATION_LOCK:-}" && -d "$OPERATION_LOCK" ]]; then
    rm -f "$OPERATION_LOCK/pid" "$OPERATION_LOCK/host" "$OPERATION_LOCK/command"
    rmdir "$OPERATION_LOCK"
  fi
  OPERATION_LOCK=""
}

on_interrupt() {
  local code="$1"
  trap - INT TERM
  if [[ -n "${ACTIVE_PLAN:-}" ]]; then
    record_failed_plan "$ACTIVE_PLAN" "$ACTIVE_METADATA" "$ACTIVE_ACTION" || true
  fi
  release_operation_lock
  exit "$code"
}

terraform_for_environment() {
  local assignments=(TF_DATA_DIR="$ENV_TF_DATA" TF_WORKSPACE="$ENV_ID" TF_IN_AUTOMATION=1)
  if [[ ! -t 1 ]]; then
    assignments+=(
      TF_CLI_ARGS_init="${TF_CLI_ARGS_init:--no-color}"
      TF_CLI_ARGS_plan="${TF_CLI_ARGS_plan:--no-color}"
      TF_CLI_ARGS_apply="${TF_CLI_ARGS_apply:--no-color}"
    )
  fi
  env ${AWS_ENV_UNSET[@]+"${AWS_ENV_UNSET[@]}"} ${DB_ENV_UNSET[@]+"${DB_ENV_UNSET[@]}"} \
    "${assignments[@]}" terraform -chdir="$ENV_DIR" "$@"
}

# Runs Terraform while keeping a private copy of its output that agents can
# tail. Pipeline status is Terraform's because pipefail is enabled.
terraform_logged() {
  local name="$1" log_dir log
  shift
  log_dir="$ENV_ARTIFACTS/logs"
  log="$log_dir/$(date -u +%Y%m%dT%H%M%SZ)-$name.log"
  (
    umask 077
    mkdir -p "$log_dir"
    : > "$log"
  )
  echo "Terraform log: $log"
  terraform_for_environment "$@" 2>&1 | tee -a "$log"
}

state_workspace_id() {
  [[ -f "${ENV_STATE:-}" ]] || return 0
  jq -r '
    (.outputs.workspace_id.value // empty | tostring),
    ([.resources[]? |
      select(.type == "databricks_mws_workspaces") |
      .instances[]?.attributes.workspace_id] |
      first // empty | tostring)
  ' "$ENV_STATE" | awk 'NF { print; exit }'
}

state_workspace_url() {
  local url
  [[ -f "${ENV_STATE:-}" ]] || return 0
  url="$(jq -r '
    (.outputs.workspace_url.value // empty),
    ([.resources[]? |
      select(.type == "databricks_mws_workspaces" or .type == "azurerm_databricks_workspace") |
      .instances[]?.attributes.workspace_url] | first // empty)
  ' "$ENV_STATE" | awk 'NF { print; exit }')"
  if [[ -n "$url" ]]; then
    normalize_host "$url"
  fi
}

# True when state holds resources managed through the workspace-level
# Databricks provider, so refresh needs workspace authentication.
state_requires_workspace_auth() {
  [[ -f "${ENV_STATE:-}" ]] || return 1
  jq -e '
    any(.resources[]?;
      (((.provider // "") | endswith("databricks/databricks\"].workspace")) or
       .type == "databricks_catalog" or
       .type == "databricks_external_location" or
       .type == "databricks_storage_credential") and
      any(.instances[]?; true)
    )
  ' "$ENV_STATE" >/dev/null
}

