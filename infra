# ---------------------------------------------------------------------------

# Copies each database's credentials from Secrets Manager into the lab check
# secret scope. Values move through pipes only: they are never printed,
# stored in a variable, or passed as a command-line argument.
sync_lab_check_credentials() {
  local workspace_url="$1" lab="$2" scope entry source arn field key
  scope="$(jq -r '.secret_scope // empty' <<< "$lab")"
  [[ "$ENV_CLOUD" == "aws" && -n "$scope" ]] || return 0
  while IFS= read -r entry; do
    source="$(jq -r .source <<< "$entry")"
    arn="$(jq -r .secret_arn <<< "$entry")"
    for field in username password; do
      key="$(jq -r --arg field "$field" '.[$field + "_key"]' <<< "$entry")"
      aws_cli secretsmanager get-secret-value --secret-id "$arn" --query SecretString --output text |
        jq -j --arg field "$field" '.[$field] // error("the secret has no \($field)")' |
        databricks_workspace_cli "$workspace_url" secrets put-secret "$scope" "$key" >/dev/null ||
        die "could not copy the $source $field into secret scope $scope"
    done
    echo "Copied the $source credentials into secret scope $scope." >&2
  done < <(jq -c '.credentials[]?' <<< "$lab")
}

# Serverless checks fail until Databricks reports the private endpoint rules
# ESTABLISHED, which takes a few minutes after approval.
wait_for_serverless_rules() {
  local outputs="$1" lab="$2" wait_seconds="$3" ncc rule_ids listed pending deadline
  jq -e '[.checks[] | select(.compute == "serverless")] | length > 0' <<< "$lab" >/dev/null || return 0
  ncc="$(jq -r '.serverless_connectivity.value.network_connectivity_config_id // empty' <<< "$outputs")"
  rule_ids="$(jq -c '[(.serverless_connectivity.value.rules // {})[] | .rule_id | select(. != null)]' <<< "$outputs")"
  [[ -n "$ncc" && "$rule_ids" != "[]" && "$wait_seconds" -gt 0 ]] || return 0
  deadline=$(($(date +%s) + wait_seconds))
  while true; do
    if ! listed="$(databricks_account_cli account network-connectivity list-private-endpoint-rules "$ncc" --output json 2>/dev/null)"; then
      echo "WARNING: could not read the NCC private endpoint rules; running the checks anyway." >&2
      return 0
    fi
    pending="$(jq -r --argjson ids "$rule_ids" '
      (if type == "array" then . else (.items // .rules // []) end)[] |
      select(.rule_id as $id | $ids | any(.[]; . == $id)) |
      select((.connection_state // "UNKNOWN") != "ESTABLISHED") |
      "\(.resource_id // .endpoint_service // .rule_id)=\(.connection_state // "UNKNOWN")"' <<< "$listed")"
    if [[ -z "$pending" ]]; then
      echo "Serverless private endpoint rules are ESTABLISHED." >&2
      return 0
    fi
    if (($(date +%s) >= deadline)); then
      echo "WARNING: serverless private endpoint rules are not ESTABLISHED yet; serverless checks may fail:" >&2
      printf '  %s\n' $pending >&2
      return 0
    fi
    echo "Waiting for serverless private endpoint rules to become ESTABLISHED: $(printf '%s ' $pending)" >&2
    sleep "${STS_INFRA_VERIFY_INTERVAL:-30}"
  done
}

verify_deployment() {
  local cloud="$1" vars="$2" format="$3" endpoint_wait="$4"
  local outputs lab workspace_url job_id run_id run life deadline task task_run output results summary status
  prepare_environment "$cloud" "$vars"
  check_legacy_state
  bind_environment
  [[ -f "$ENV_STATE" ]] || die "state not found for deployment '$ENV_ID'; plan and apply it first"
  acquire_operation_lock
  { preflight "$cloud" verify; } >&2
  outputs="$(terraform_for_environment output -json)"
  lab="$(jq -c '.lab_check.value // empty' <<< "$outputs")"
  if [[ -z "$lab" ]]; then
    if [[ "$(jq -r '.deployment_stage.value // empty' <<< "$outputs")" == "foundation" ]]; then
      die "the lab check job is added by the second deployment stage: run $(setup_fix), then ./infra plan and ./infra apply"
    fi
    die "this deployment has no lab check job. It exists when the workspace is enabled, lab_check.enabled is not false, and at least one source has a classic or serverless path"
  fi
  workspace_url="$(state_workspace_url)"
  job_id="$(jq -r .job_id <<< "$lab")"

  sync_lab_check_credentials "$workspace_url" "$lab"
  wait_for_serverless_rules "$outputs" "$lab" "$endpoint_wait"

  run_id="$(databricks_workspace_cli "$workspace_url" jobs run-now "$job_id" --no-wait --output json | jq -r '.run_id // empty')"
  [[ -n "$run_id" ]] || die "could not start the lab check job $job_id"
  echo "Started lab check run $run_id. Classic checks start a small cluster, which takes about 5 minutes." >&2
  deadline=$(($(date +%s) + ${STS_INFRA_VERIFY_TIMEOUT:-3600}))
  while true; do
    run="$(databricks_workspace_cli "$workspace_url" jobs get-run "$run_id" --output json)" ||
      die "could not read lab check run $run_id"
    life="$(jq -r '.state.life_cycle_state // empty' <<< "$run")"
    case "$life" in
      TERMINATED|SKIPPED|INTERNAL_ERROR) break ;;
    esac
    (($(date +%s) < deadline)) || die "lab check run $run_id did not finish in time; see $(jq -r '.run_page_url // empty' <<< "$run")"
    echo "  $(jq -r '[.tasks[]? | "\(.task_key)=\(.state.result_state // .state.life_cycle_state)"] | join(" ")' <<< "$run")" >&2
    sleep "${STS_INFRA_VERIFY_INTERVAL:-30}"
  done

  results='[]'
  while IFS=$'\t' read -r task task_run; do
    [[ -n "$task" ]] || continue
    output="$(databricks_workspace_cli "$workspace_url" jobs get-run-output "$task_run" --output json 2>/dev/null || echo '{}')"
    results="$(jq -c --arg task "$task" --argjson run "$run" --argjson output "$output" --argjson lab "$lab" '
      ($run.tasks[] | select(.task_key == $task)) as $state |
      ($lab.checks[$task] // {}) as $check |
      (($output.notebook_output.result // "") | fromjson? // {}) as $result |
      (($output.error // $state.state.state_message // "") |
        capture("LAB CHECK FAILED at (?<stage>[a-z]+): (?<message>.*?) Hint: (?<hint>.*)") // {}) as $failure |
      . + [{
        check: $task,
        source: $check.source,
        compute: $check.compute,
        mode: $check.mode,
        engine: $check.engine,
        status: (if $state.state.result_state == "SUCCESS" and $result.status == "passed" then "passed"
                 elif ($state.state.result_state // "") == "UPSTREAM_FAILED" or ($state.state.result_state // "") == "EXCLUDED" then "skipped"
                 else "failed" end),
        rows: ($result.rows // null),
        seeded: ($result.seeded // null),
        stage: ($failure.stage // null),
        error: (if $state.state.result_state == "SUCCESS" then null
                else ($failure.message // $output.error // $state.state.state_message // "the task did not finish") end),
        hint: ($failure.hint // null),
        # Unclassified failures keep the end of the traceback so the cause is
        # visible without opening the run.
        trace: (if $state.state.result_state == "SUCCESS" or $failure.stage then null
                else (($output.error_trace // "") | gsub("\u001b\\[[0-9;]*m"; "") | split("\n") |
                      map(select(test("\\S"))) | .[-12:] | join("\n") | if . == "" then null else . end) end)
      }]' <<< "$results")"
  done < <(jq -r '.tasks[]? | [.task_key, (.run_id | tostring)] | @tsv' <<< "$run")

  status="$(jq -r 'if length > 0 and all(.[]; .status == "passed") then "passed" else "failed" end' <<< "$results")"
  summary="$(jq -n --arg cloud "$ENV_CLOUD" --arg id "$ENV_ID" --arg status "$status" --argjson run "$run" \
    --argjson lab "$lab" --argjson checks "$results" --arg checked_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{
      version: 1,
      cloud: $cloud,
      deployment_id: $id,
      status: $status,
      checked_at: $checked_at,
      run_id: $run.run_id,
      run_url: ($run.run_page_url // null),
      job_url: ($lab.job_url // null),
      checks: $checks
    }')"
  (umask 077; printf '%s\n' "$summary" > "$ENV_ARTIFACTS/verify.json")

  if [[ "$format" == "json" ]]; then
    printf '%s\n' "$summary"
  else
    echo "Lab check results for $ENV_CLOUD/$ENV_ID ($(jq -r '.run_url // "run \(.run_id)"' <<< "$summary")):"
    jq -r '.checks[] |
      "  " + (if .status == "passed" then "[pass]" elif .status == "skipped" then "[skip]" else "[FAIL]" end) + " " +
      "\(.source) from \(.compute) compute over \(.mode)" +
      (if .status == "passed" then
         (if .rows then ": sample data " + (.rows | to_entries | map("\(.key)=\(.value)") | join(", ")) else ": reachable" end)
       else ": " + ((if .stage then .stage + ": " else "" end) + (.error // "")) end) +
      (if .hint then "\n         hint: " + .hint else "" end) +
      (if .trace then "\n         traceback (last lines):\n" + (.trace | split("\n") | map("           " + .) | join("\n")) else "" end)' <<< "$summary"
    if [[ "$status" == "passed" ]]; then
      echo "All network paths work."
    else
      echo "Some checks failed. Fix the path, then rerun: ./infra verify $ENV_CLOUD $DISPLAY_VARS"
    fi
  fi
  [[ "$status" == "passed" ]] || exit "$EXIT_VERIFY_FAILED"
}

show_outputs() {
  local cloud="$1" vars="$2" format="${3:-text}"
  prepare_environment "$cloud" "$vars"
  check_legacy_state
  bind_environment
  [[ -f "$ENV_STATE" ]] || die "state not found for deployment '$ENV_ID'"
  if [[ "$format" == "json" ]]; then
    # Sensitive values are redacted so outputs are safe to show in logs.
    terraform_for_environment output -json |
      jq 'with_entries(if .value.sensitive then .value.value = "<sensitive>" else . end)'
  else
    terraform_for_environment output
  fi
}

main() {
  local command="${1:-}" vars seed_vars seed_source seed_destination
  INFRA_COMMAND_LINE="./infra $*"
  command -v jq >/dev/null 2>&1 || die_code "$EXIT_MISSING_TOOL" "jq is required"
  case "$command" in
    list)
      [[ $# -eq 1 ]] || { usage; exit 2; }
      jq . "$ROOT/components.json"
      ;;
    templates|new|explain|ls|status)
      command -v python3 >/dev/null 2>&1 || die_code "$EXIT_MISSING_TOOL" "python3 is required for ./infra $command"
      STS_INFRA_ROOT="$ROOT" STS_INFRA_TARGETS_FILE="$(targets_path)" exec python3 -I "$ROOT/lib/infra_scenario.py" "$@"
      ;;
    targets)
      shift
      targets_command "$@"
      ;;
    verify)
      [[ $# -ge 3 ]] || { usage; exit 2; }
      cloud_root "$2" >/dev/null
      local verify_cloud="$2" verify_vars="$3" verify_format=text verify_wait=900
      shift 3
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --json) verify_format=json; shift ;;
          --endpoint-wait)
            [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die_code 2 "--endpoint-wait requires a number of seconds"
            verify_wait="$2"
            shift 2
            ;;
          *) usage; exit 2 ;;
        esac
      done
      verify_deployment "$verify_cloud" "$verify_vars" "$verify_format" "$verify_wait"
      ;;
    setup)
      [[ $# -ge 3 ]] || { usage; exit 2; }
      cloud_root "$2" >/dev/null
      vars="$3"
      local cloud="$2"
      shift 3
      parse_setup_options "$@"
      case "$cloud" in
        aws) setup_aws_authentication "$vars" ;;
        azure) setup_azure_authentication "$vars" ;;
      esac
      ;;
    doctor|auth)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      [[ "$command" != "auth" ]] || echo "WARNING: './infra auth' is deprecated; use './infra doctor'." >&2
      shift
      doctor_command "$@"
      ;;
    validate)
      [[ $# -eq 2 ]] || { usage; exit 2; }
      "$ROOT/scripts/validate.sh" "$2"
      ;;
    plan)
      [[ $# -eq 3 ]] || { usage; exit 2; }
      create_plan "$2" "$3" apply
      ;;
    apply)
      [[ $# -eq 3 ]] || { usage; exit 2; }
      apply_plan "$2" "$3" apply
      ;;
    seed-access-plan)
      [[ "${2:-}" == "azure" ]] || die "seed access currently supports azure only"
      if [[ $# -eq 3 ]]; then
        create_seed_access_plan "$3"
      elif [[ $# -eq 5 && "$4" == "--operator-ip" && -n "$5" ]]; then
        create_seed_access_plan "$3" "$5"
      else
        usage
        exit 2
      fi
      ;;
    seed-access-apply)
      [[ $# -eq 3 && "$2" == "azure" ]] || die "seed-access-apply requires: azure <environment.tfvars>"
      apply_seed_access_plan "$3"
      ;;
    seed)
      [[ "${2:-}" == "azure" && $# -ge 3 ]] || die "seed requires: azure <environment.tfvars> [--source <directory>] [--destination-path <path>]"
      seed_vars="$3"
      seed_source="$ROOT/modules/azure/external-volume-storage/assets/sample-json"
      seed_destination="$(tfvar_value "$(absolute_file "$seed_vars")" volume_storage_path external_volume_storage)"
      seed_destination="${seed_destination:-volume}"
      shift 3
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --source)
            [[ $# -ge 2 ]] || die "--source requires a directory"
            seed_source="$2"
            shift 2
            ;;
          --destination-path)
            [[ $# -ge 2 ]] || die "--destination-path requires a path"
            seed_destination="$2"
            shift 2
            ;;
          *) die "unknown seed option: $1" ;;
        esac
      done
      seed_external_volume "$seed_vars" "$seed_source" "$seed_destination"
      ;;
    output)
      if [[ $# -eq 3 ]]; then
        show_outputs "$2" "$3"
      elif [[ $# -eq 4 && "$4" == "--json" ]]; then
        show_outputs "$2" "$3" json
      else
        usage
        exit 2
      fi
      ;;
    destroy-plan)
      [[ $# -eq 3 ]] || { usage; exit 2; }
      create_plan "$2" "$3" destroy
      ;;
    destroy)
      [[ $# -eq 5 && "$4" == "--confirm" && "$5" == "destroy-$2" ]] || die "destroy requires: --confirm destroy-<cloud>"
      apply_plan "$2" "$3" destroy
      ;;
    state-migrate)
      [[ $# -eq 5 && "$4" == "--confirm" ]] || die "state migration requires an environment-specific confirmation; see ./infra usage"
      migrate_state "$2" "$3" "$5"
      ;;
    endpoints)
      [[ "${2:-}" == "aws" || "${2:-}" == "azure" ]] || die "endpoint operations support aws or azure"
      if [[ "$2" == "azure" ]]; then
        case "${3:-}" in
          status)
            [[ $# -eq 4 ]] || { usage; exit 2; }
            prepare_environment azure "$4"
            check_legacy_state
            bind_environment
            [[ -f "$ENV_STATE" ]] || die "state not found for deployment '$ENV_ID'"
            azure_endpoint_status_json | jq '{pending_endpoint_approvals: .}'
            ;;
          approve)
            [[ $# -eq 6 && "${5:-}" == "--connection-id" && -n "${6:-}" ]] || die "approve requires: <environment.tfvars> --connection-id <id>"
            prepare_environment azure "$4"
            bind_environment
            preflight azure endpoint
            decide_azure_endpoint approve "$6"
            ;;
          reject)
            [[ $# -eq 8 && "${5:-}" == "--connection-id" && -n "${6:-}" && "${7:-}" == "--confirm" && "${8:-}" == "reject-azure-endpoint" ]] || die "reject requires: <environment.tfvars> --connection-id <id> --confirm reject-azure-endpoint"
            prepare_environment azure "$4"
            bind_environment
            preflight azure endpoint
            decide_azure_endpoint reject "$6"
            ;;
          *) usage; exit 2 ;;
        esac
        return 0
      fi
      case "${3:-}" in
        status)
          [[ $# -eq 4 ]] || { usage; exit 2; }
          prepare_environment aws "$4"
          check_legacy_state
          bind_environment
          [[ -f "$ENV_STATE" ]] || die "state not found for deployment '$ENV_ID'"
          terraform_for_environment output -json | jq '{
            pending_endpoint_acceptances: (.pending_endpoint_acceptances.value // []),
            connectivity: .connectivity.value,
            ncc_rules: .ncc_rules.value
          }'
          ;;
        accept)
          [[ $# -eq 8 && "${5:-}" == "--service-id" && "${7:-}" == "--endpoint-id" && -n "${6:-}" && -n "${8:-}" ]] || die "accept requires: <environment.tfvars> --service-id <id> --endpoint-id <id>"
          prepare_environment aws "$4"
          preflight aws endpoint
          aws_cli ec2 accept-vpc-endpoint-connections --service-id "$6" --vpc-endpoint-ids "$8"
          ;;
        reject)
          [[ $# -eq 10 && "${5:-}" == "--service-id" && "${7:-}" == "--endpoint-id" && "${9:-}" == "--confirm" && "${10:-}" == "reject-aws-endpoint" && -n "${6:-}" && -n "${8:-}" ]] || die "reject requires: <environment.tfvars> --service-id <id> --endpoint-id <id> --confirm reject-aws-endpoint"
          prepare_environment aws "$4"
          preflight aws endpoint
          aws_cli ec2 reject-vpc-endpoint-connections --service-id "$6" --vpc-endpoint-ids "$8"
          ;;
        *) usage; exit 2 ;;
      esac
      ;;
    *) usage; exit 2 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
