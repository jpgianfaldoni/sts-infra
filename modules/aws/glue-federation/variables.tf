variable "name_prefix" {
  description = "Prefix for the AWS Glue federation test resources."
  type        = string

  validation {
    condition = (
      length(trimspace(var.name_prefix)) >= 1 &&
      length(trimspace(var.name_prefix)) <= 32 &&
      can(regex("^[A-Za-z0-9][A-Za-z0-9_-]*$", var.name_prefix))
    )
    error_message = "name_prefix must be 1-32 characters and contain only letters, numbers, hyphens, or underscores."
  }
}

variable "region" {
  description = "AWS region containing the Glue Data Catalog."
  type        = string
}

variable "databricks_connectivity_enabled" {
  description = "Create the Databricks service/storage credentials, external location, Glue connection, and foreign catalog."
  type        = bool
  default     = false
}

variable "databricks_metastore_assignment_id" {
  description = "Dependency token for the workspace's completed Unity Catalog metastore assignment."
  type        = string
  default     = null
  nullable    = true
}

variable "databricks_unity_catalog_iam_arn" {
  description = "Unity Catalog IAM principal used for the manual two-stage credential setup when Databricks connectivity is disabled."
  type        = string
  default     = "arn:aws:iam::414351767826:role/unity-catalog-prod-UCMasterRole-14S5ZJVKOTYTL"

  validation {
    condition     = can(regex("^arn:[^:]+:iam::[0-9]{12}:role/.+$", var.databricks_unity_catalog_iam_arn))
    error_message = "databricks_unity_catalog_iam_arn must be a valid IAM role ARN."
  }
}

variable "service_credential_external_id" {
  description = "External ID generated by a manually created Databricks service credential. Ignored when Databricks connectivity is enabled."
  type        = string
  default     = "0000"

  validation {
    condition     = trimspace(var.service_credential_external_id) != ""
    error_message = "service_credential_external_id must not be empty."
  }
}

variable "storage_credential_external_id" {
  description = "External ID generated by a manually created Databricks storage credential. Ignored when Databricks connectivity is enabled."
  type        = string
  default     = "0000"

  validation {
    condition     = trimspace(var.storage_credential_external_id) != ""
    error_message = "storage_credential_external_id must not be empty."
  }
}

variable "force_destroy" {
  description = "Allow deletion of the non-empty, versioned sample bucket. Keep false outside disposable environments."
  type        = bool
  default     = false
}

variable "tags" {
  type    = map(string)
  default = {}
}
