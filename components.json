{
  "schema_version": 2,
  "clouds": {
    "aws": {
      "root": "deployments/aws",
      "components": {
        "workspace": { "module": "databricks-workspace", "feature": "features.workspace", "dependencies": [] },
        "unity_catalog": { "module": "unity-catalog", "feature": "features.unity_catalog", "dependencies": ["workspace"] },
        "rds_postgres": { "module": "rds-postgres", "feature": "features.rds_postgres", "connectivity": { "classic": { "path": "connectivity.rds_postgres.classic", "modes": ["none", "peering", "private_link"] }, "serverless": { "path": "connectivity.rds_postgres.serverless", "modes": ["none", "private_link"] } } },
        "rds_sql_server": { "module": "rds-sql-server", "feature": "features.rds_sql_server", "connectivity": { "classic": { "path": "connectivity.rds_sql_server.classic", "modes": ["none", "peering", "private_link"] }, "serverless": { "path": "connectivity.rds_sql_server.serverless", "modes": ["none", "private_link"] } } },
        "aurora_postgres": { "module": "aurora-postgres", "feature": "features.aurora_postgres", "connectivity": { "classic": { "path": "connectivity.aurora_postgres.classic", "modes": ["none", "peering", "private_link"] }, "serverless": { "path": "connectivity.aurora_postgres.serverless", "modes": ["none", "private_link"] } } },
        "aurora_proxy": { "module": "aurora-postgres", "feature": "features.aurora_proxy", "dependencies": ["aurora_postgres"] },
        "rabbitmq": { "module": "rabbitmq", "feature": "features.rabbitmq", "connectivity": { "classic": { "path": "connectivity.rabbitmq.classic", "modes": ["none", "peering", "private_link"] }, "serverless": { "path": "connectivity.rabbitmq.serverless", "modes": ["none", "private_link"] } } },
        "simulated_on_prem": { "module": "simulated-on-prem", "feature": "features.simulated_on_prem", "connectivity": { "classic": { "path": "connectivity.simulated_on_prem.classic", "modes": ["none", "transit_gateway"] } } },
        "classic_private_link": { "module": "classic-private-link", "feature": "derived.classic_private_link", "dependencies": ["workspace"] },
        "ncc": { "module": "ncc", "feature": "derived.serverless_private_link", "dependencies": ["workspace"] },
        "transit_gateway": { "module": "transit-gateway", "feature": "derived.simulated_on_prem_transit_gateway", "dependencies": ["workspace", "simulated_on_prem"] }
      }
    },
    "azure": {
      "root": "deployments/azure",
      "components": {
        "workspace": { "module": "databricks-workspace", "feature": "features.workspace", "dependencies": [] },
        "sql_database": { "module": "sql-database", "feature": "features.sql_database", "dependencies": [] },
        "sql_server_vm": { "module": "sql-server-vm", "feature": "features.sql_server_vm", "dependencies": [] }
      }
    }
  }
}
